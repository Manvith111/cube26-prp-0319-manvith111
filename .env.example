# --- OpsConsole / Prep Manager configuration ---
#
# The easiest way to configure the app is the in-app Settings page
# (/settings) — it stores your key in data/config.json. These environment
# variables are an optional alternative and act as a fallback when no key is
# saved in the app.

# Google Gemini API key used for the Prep Manager vision step.
# Get one at https://aistudio.google.com/apikey.
GEMINI_API_KEY=AQ.REPLACE-WITH-YOUR-KEY
# GOOGLE_API_KEY is also accepted as a fallback name.

# Vision model used to OBSERVE the photos (it never decides verdicts).
# Default is gemini-flash-latest. Other options: gemini-flash-lite-latest,
# gemini-pro-latest, gemini-3.8-flash, gemini-2.5-flash.
# If the chosen model is temporarily overloaded, the app automatically falls
# back to gemini-flash-lite-latest for that request.
PREP_VISION_MODEL=gemini-flash-latest
